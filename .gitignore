# docs/ is scratch, with one exception: the writing rules every page and
# every commit message in this repo is held to. A negation cannot re-include a
# file under an excluded directory, hence docs/* rather than docs/.
docs/*
!docs/instructions.md
.cursor/
rag_export/
*.dump
*.tar.gz
nginx/certs/

