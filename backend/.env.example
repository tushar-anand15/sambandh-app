DATABASE_URL=postgresql://sambandh:sambandh@localhost:5434/sambandh
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# RAG / Search
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
SEARCH_TOP_K=10
DENSE_RECALL_K=50
FTS_RECALL_K=50
RRF_K=60
RERANK_CANDIDATE_K=40

# Reranker
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANKER_ENABLED=true

# LLM (via LiteLLM — supports gemini/, openai/, anthropic/, groq/ prefixes)
LLM_PROVIDER=gemini/gemini-2.0-flash
LLM_API_KEY=
LLM_MODEL=

# Message limits
MAX_MESSAGE_LENGTH=2000

# Boundary layers. The seven GeoJSON layers sulekha's `geo build` emits, from
# 7.5 MB to 57 MB, are not in this repository: a deployment copies them here
# and points this at the directory. Unset means /geo serves nothing and
# /api/maps says so per layer.
# GEO_DIR=/srv/gramsambandh/geo
