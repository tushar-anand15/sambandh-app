# Production configuration that is not secret, and is therefore in the
# repository where it can be reviewed in a diff rather than edited in place on
# the VM. deploy.sh concatenates this with the values it fetches from Secret
# Manager and hands the result to `docker compose --env-file`.
#
# The rule for what belongs here: if publishing the line would not let anyone do
# anything, it goes here. A project id and a region are not secrets. A signing
# key, a database password and an API key are, and they are in Secret Manager
# under gramsambandh-jwt-secret, gramsambandh-postgres-password,
# gramsambandh-umami-app-secret and gramsambandh-llm-api-key.

LLM_PROVIDER=vertex_ai/gemini-2.5-flash
VERTEXAI_PROJECT=sulekhasakarma-495616
VERTEXAI_LOCATION=asia-south1
GCP_PROJECT=sulekhasakarma-495616
GCP_LOCATION=asia-south1

# The reranker's library is not in the image, so `app/reranker.py` already
# degrades on ImportError and this changes no behaviour. It is set anyway so
# that the configuration states the intent rather than depending on an import
# failing: `reranker_enabled` defaults to True in app/config.py, and a reader
# checking whether production reranks should not have to know that.
RERANKER_ENABLED=false
