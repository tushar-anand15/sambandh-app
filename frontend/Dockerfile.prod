# Stage 1: Build
FROM node:22-slim AS builder

WORKDIR /app

# npm, against package-lock.json, because that is the lockfile CI actually
# tests. This image used to build with pnpm from pnpm-lock.yaml while
# .github/workflows/test.yml ran `npm ci` from package-lock.json, so the tree
# the suite proved and the tree the users got were resolved from two different
# files and nothing checked that they agreed. The pnpm lockfile has been
# deleted rather than kept in step; one lockfile cannot drift from itself.
#
# It also removes an unpinned toolchain. The previous line was
# `corepack prepare pnpm@latest`, which is a different package manager on
# different days: the build that prompted this change failed on
# ERR_PNPM_IGNORED_BUILDS, a policy recent pnpm applies to postinstall scripts
# and older pnpm did not, on a commit whose dependencies had not moved at all.
#
# `npm ci` and not `npm install`: it installs exactly the lockfile and fails if
# package.json disagrees with it, where `npm install` would quietly resolve
# something new and write it back. The old line ended `|| pnpm install`, which
# meant a lockfile mismatch was not an error at all -- production would simply
# get whatever resolved that morning.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite substitutes `import.meta.env.VITE_*` at build time, so these are
# properties of the image, not of the container. Setting them in compose does
# nothing; they have to be here, which is why the deploy workflow passes them as
# build args. Both unset produces a bundle that sends no telemetry at all —
# `telemetryConfig()` returns null when either is missing — so an image built
# without them is a working image, not a broken one.
ARG VITE_UMAMI_HOST=
ARG VITE_UMAMI_WEBSITE_ID=
ENV VITE_UMAMI_HOST=${VITE_UMAMI_HOST}
ENV VITE_UMAMI_WEBSITE_ID=${VITE_UMAMI_WEBSITE_ID}

# There is deliberately no API_URL here. An earlier version of this file took
# one and it never did anything: `API_URL` is read by vite.config.ts to point
# the *dev server's* proxy at a backend, and `vite build` does not run the dev
# server. The built bundle calls `/api` relatively (src/lib/api.ts), and nginx
# in the stage below is what routes that to the backend container.
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
